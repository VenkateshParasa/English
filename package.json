{
  "name": "english-learning-portal",
  "version": "1.0.0",
  "description": "Interactive English Learning Portal with unlimited practice exercises",
  "main": "index.html",
  "scripts": {
    "start": "http-server -p 3000 -o -c-1",
    "dev": "http-server -p 3000 -o -c-1",
    "serve": "http-server -p 8080 -c-1",
    "deploy:netlify": "netlify deploy --prod",
    "deploy:vercel": "vercel --prod",
    "test": "jest --coverage",
    "test:unit": "jest __tests__/unit",
    "test:integration": "jest __tests__/integration --passWithNoTests",
    "test:watch": "jest --watch",
    "test:verbose": "jest --verbose"
  },
  "keywords": [
    "english",
    "learning",
    "education",
    "vocabulary",
    "grammar",
    "pwa",
    "offline"
  ],
  "author": "Venkatesh Parasa",
  "license": "MIT",
  "devDependencies": {
    "http-server": "^14.1.1",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/english-learning-portal.git"
  },
  "homepage": "https://yourusername.github.io/english-learning-portal"
}
